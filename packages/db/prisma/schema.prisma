// DerivDesk — shared database schema.
//
// This schema is the single source of truth for the DB structure, but it is
// consumed by TWO separately deployed backends with different privileges:
//   - apps/api        connects as `derivdesk_api`   (client-facing, no admin tables)
//   - apps/admin-api  connects as `derivdesk_admin` (ops-facing, no oauth-token access)
// The actual privilege split is enforced in Postgres (see infra/db-init/001_roles.sql),
// not just in application code — a bug in one app's queries can't reach the other's data.

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Client identity (owned by apps/api)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  // Identity is Deriv (Phase 11): users are created ONLY by signing in with Deriv, so there is no
  // password and, because Deriv documents no email/user-info claim, usually no email either.
  // `email`/`passwordHash` are LEGACY columns kept nullable (expand step; never written any more) and
  // will be dropped in a later "contract" migration. `handle` is the human-readable identifier
  // (the user's primary Deriv account id, e.g. CR1234567) shown in the UI, audit log and admin.
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  handle       String   @unique
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  sessions          Session[]
  derivOAuthTokens  DerivOAuthToken[]
  derivAccounts     DerivAccount[]
  watchlists        Watchlist[]
  localTrades       LocalTrade[]
  transactions      TransactionCache[]
  withdrawals       PaymentAgentWithdrawal[]
  analyticsSnapshots AnalyticsSnapshot[]
  notifications     Notification[]
  botInstances      BotInstance[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")

  // Which Deriv account this session is currently operating on. Per-SESSION on
  // purpose: a fresh login always starts with no real account selected, so real
  // trading can never be the silent default. Ownership is enforced in code
  // (the account must belong to session.userId) before this is ever set.
  activeDerivAccountId String?       @map("active_deriv_account_id")
  activeDerivAccount   DerivAccount? @relation(fields: [activeDerivAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Admin identity — deliberately NOT related to User. Separate table, separate
// login, separate session, so the admin deployment never needs to touch the
// client identity table at all.
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  totpSecretEnc String?  @map("totp_secret_enc") // encrypted TOTP secret; null until 2FA is enrolled
  status       AdminUserStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  sessions AdminSession[]

  @@map("admin_users")
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

model AdminSession {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  ip          String?
  userAgent   String?   @map("user_agent")

  @@index([adminUserId])
  @@map("admin_sessions")
}

// ---------------------------------------------------------------------------
// Deriv connection state (owned by apps/api; admin-api has NO grant on
// deriv_oauth_tokens at all — see infra/db-init/001_roles.sql)
// ---------------------------------------------------------------------------

model DerivOAuthToken {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authType       DerivAuthType @map("auth_type")
  accessTokenEnc String   @map("access_token_enc")
  refreshTokenEnc String? @map("refresh_token_enc")
  scopes         String
  expiresAt      DateTime @map("expires_at")
  derivClientId  String   @map("deriv_client_id")
  needsReauth    Boolean  @default(false) @map("needs_reauth") // refresh failed; user must reconnect
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId]) // one Deriv connection per app user
  @@map("deriv_oauth_tokens")
}

enum DerivAuthType {
  OAUTH
  PAT
}

model DerivAccount {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  derivAccountId String   @map("deriv_account_id")
  accountType    DerivAccountType @map("account_type")
  currency       String
  group          String
  status         String
  nickname       String?
  cachedBalance  Decimal? @map("cached_balance") @db.Decimal(18, 4)
  cachedBalanceAt DateTime? @map("cached_balance_at")

  localTrades  LocalTrade[]
  transactions TransactionCache[]
  withdrawals  PaymentAgentWithdrawal[]
  analyticsSnapshots AnalyticsSnapshot[]
  activeInSessions   Session[]
  botInstances       BotInstance[]

  @@unique([userId, derivAccountId])
  // One Deriv account belongs to exactly one app user. Sign-in resolves the user by the Deriv account
  // ids Deriv returns for the authorising token, so this must be an invariant of the database.
  @@unique([derivAccountId])
  @@index([userId, accountType])
  @@map("deriv_accounts")
}

enum DerivAccountType {
  DEMO
  REAL
}

// ---------------------------------------------------------------------------
// Watchlists
// ---------------------------------------------------------------------------

model Watchlist {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String @default("Default")

  items WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(uuid())
  watchlistId String    @map("watchlist_id")
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol      String
  sortOrder   Int       @default(0) @map("sort_order")

  @@index([watchlistId])
  @@map("watchlist_items")
}

// ---------------------------------------------------------------------------
// Trading / transactions read-models (reconciled cache, never authoritative)
// ---------------------------------------------------------------------------

model LocalTrade {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  derivAccountId String   @map("deriv_account_id")
  derivAccount   DerivAccount @relation(fields: [derivAccountId], references: [id], onDelete: Cascade)
  contractId     String   @map("contract_id")
  transactionId  String   @map("transaction_id")
  contractType   String   @map("contract_type")
  underlyingSymbol String @map("underlying_symbol")
  buyPrice       Decimal  @map("buy_price") @db.Decimal(18, 4)
  payout         Decimal? @db.Decimal(18, 4)
  purchaseTime   DateTime @map("purchase_time")
  status         TradeStatus @default(OPEN)
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at")

  @@unique([derivAccountId, contractId])
  @@index([userId, status])
  @@map("local_trades")
}

enum TradeStatus {
  OPEN
  CLOSED
  SOLD
  CANCELLED
}

model TransactionCache {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  derivAccountId    String   @map("deriv_account_id")
  derivAccount      DerivAccount @relation(fields: [derivAccountId], references: [id], onDelete: Cascade)
  derivTransactionId String  @map("deriv_transaction_id")
  type              String
  amount            Decimal  @db.Decimal(18, 4)
  currency          String
  balanceAfter      Decimal? @map("balance_after") @db.Decimal(18, 4)
  occurredAt        DateTime @map("occurred_at")
  source            TransactionSource

  @@unique([derivAccountId, derivTransactionId])
  @@index([userId, occurredAt(sort: Desc)])
  @@map("transactions_cache")
}

enum TransactionSource {
  STATEMENT
  TRANSACTION
  PROFIT_TABLE
}

// ---------------------------------------------------------------------------
// Payments — payment-agent withdrawals only (the only API-reachable withdrawal
// path; deposits and direct cashier withdrawals are never modeled here because
// no such API exists — see Phase 1 §2 and §10).
// ---------------------------------------------------------------------------

model PaymentAgentWithdrawal {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  derivAccountId String   @map("deriv_account_id")
  derivAccount   DerivAccount @relation(fields: [derivAccountId], references: [id], onDelete: Cascade)
  agentId        String   @map("agent_id")
  amount         Decimal  @db.Decimal(18, 4)
  currency       String
  requestId      String   @unique @map("request_id")
  status         WithdrawalStatus @default(PENDING)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("payment_agent_withdrawals")
}

enum WithdrawalStatus {
  REQUESTED
  PENDING
  COMPLETE
  REJECTED
  FAILED
}

// ---------------------------------------------------------------------------
// Analytics (derived only from local_trades / transactions_cache)
// ---------------------------------------------------------------------------

model AnalyticsSnapshot {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  derivAccountId String   @map("deriv_account_id")
  derivAccount   DerivAccount @relation(fields: [derivAccountId], references: [id], onDelete: Cascade)
  period         String   // e.g. "2026-09-daily", "2026-W39", "2026-09"
  winRate        Decimal? @map("win_rate") @db.Decimal(5, 4)
  netPnl         Decimal  @map("net_pnl") @db.Decimal(18, 4)
  tradesCount    Int      @map("trades_count")
  computedAt     DateTime @default(now()) @map("computed_at")

  @@unique([derivAccountId, period])
  @@map("analytics_snapshots")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit log — written by BOTH apps/api (financial actions) and apps/admin-api
// (operational actions). Deliberately not FK'd to either identity table since
// the actor may be a client User or an AdminUser from a different deployment;
// actorEmail is a point-in-time snapshot for readability if the actor is later
// deleted or suspended.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorType  ActorType @map("actor_type")
  actorId    String   @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

enum ActorType {
  CLIENT
  ADMIN
  SYSTEM
}

// ---------------------------------------------------------------------------
// Bot trading — admin manages the strategy CATALOG only (templates: name,
// description, indicator/rule/staking definition). Each BotInstance is
// entirely owned by a client user: their own Deriv account, their own risk
// parameters, their own explicit real-money confirmation. derivdesk_admin has
// SELECT/INSERT/UPDATE on bot_strategies and NO grant at all on bot_instances
// or bot_trades (see infra/db-init/001_roles.sql) — the same hard boundary as
// deriv_oauth_tokens/local_trades: admin can define what a strategy looks
// like, never touch a client's money, credentials, or running bot.
// ---------------------------------------------------------------------------

model BotStrategy {
  id          String   @id @default(uuid())
  key         String   @unique // stable slug, e.g. "ema-rsi-macd-martingale" — referenced in code/seeds
  name        String
  description String
  // A StrategyDefinition (see apps/api/src/modules/bots/strategy.schema.ts) — indicators,
  // entry rules, default staking/risk parameters. Validated by that Zod schema on every
  // admin write; never trusted as pre-validated just because it's already in the column.
  definition  Json
  status      BotStrategyStatus @default(DRAFT)
  createdBy   String?  @map("created_by") // admin_users.id, no FK — cross-deployment, like feature_flags.updatedBy
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  instances BotInstance[]

  @@map("bot_strategies")
}

enum BotStrategyStatus {
  DRAFT // visible to admin only, not selectable by users yet
  PUBLISHED // selectable by users when creating a new bot instance
  ARCHIVED // no longer selectable for NEW instances; existing instances keep running
}

model BotInstance {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  derivAccountId String       @map("deriv_account_id")
  derivAccount   DerivAccount @relation(fields: [derivAccountId], references: [id], onDelete: Cascade)
  strategyId     String       @map("strategy_id")
  strategy       BotStrategy  @relation(fields: [strategyId], references: [id], onDelete: Restrict) // a strategy in use can't be hard-deleted out from under a running instance

  name        String // the user's own label for this instance, e.g. "My R_100 EMA bot"
  symbol      String // Deriv underlying symbol this instance trades, e.g. "R_100"
  // User-owned overrides of the strategy template's staking/riskLimits (same shapes as
  // StrategyDefinition.staking / .riskLimits) — the instance's own stake size and stop-loss/
  // target-profit, never the admin template's defaults taken as-is for real money.
  riskParams  Json     @map("risk_params")
  confirmReal Boolean  @default(false) @map("confirm_real") // explicit real-money confirmation — mirrors manual trading's confirmReal; never a silent default

  status      BotInstanceStatus @default(DRAFT)
  stopReason  String?  @map("stop_reason") // e.g. "STOP_LOSS_REACHED" — see apps/api's staking.ts StopReason
  // Running state the bot runner persists between evaluations so an instance survives a
  // process restart without losing its stake-ladder position or session P/L (the
  // "server-side, always-on" requirement) — shapes match staking.ts's StakingState/RiskState.
  stakingState Json    @default("{\"currentStep\":0}") @map("staking_state")
  riskState    Json    @default("{\"sessionProfitLoss\":0,\"consecutiveLosses\":0,\"tradesCount\":0}") @map("risk_state")

  lastEvaluatedAt DateTime? @map("last_evaluated_at")
  lastError       String?   @map("last_error")
  startedAt       DateTime? @map("started_at")
  stoppedAt       DateTime? @map("stopped_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  trades BotTrade[]

  @@index([userId])
  @@index([status])
  @@map("bot_instances")
}

enum BotInstanceStatus {
  DRAFT // configured but never started
  RUNNING
  PAUSED // user-paused; resumable
  STOPPED // user-stopped, or a risk limit/kill switch fired (see stopReason)
  ERROR // the runner hit an unrecoverable error (see lastError) and stopped itself
}

// One row per trade the bot actually placed — the bot's own trade log, separate from
// local_trades (manual trading's cache) so a user's bot history and manual history can be
// told apart without inferring it from context. Deriv's own records remain authoritative for
// the trade's true outcome; this is a reconciled read-model, same caveat as local_trades.
model BotTrade {
  id            String      @id @default(uuid())
  botInstanceId String      @map("bot_instance_id")
  botInstance   BotInstance @relation(fields: [botInstanceId], references: [id], onDelete: Cascade)
  contractId    String      @map("contract_id")
  transactionId String      @map("transaction_id")
  contractType  String      @map("contract_type")
  stake         Decimal     @db.Decimal(18, 4)
  stakeStep     Int         @map("stake_step") // the staking ladder position this trade was placed at
  payout        Decimal?    @db.Decimal(18, 4)
  profit        Decimal?    @db.Decimal(18, 4) // null while OPEN; set once settled
  status        TradeStatus @default(OPEN)
  placedAt      DateTime    @map("placed_at")
  settledAt     DateTime?   @map("settled_at")

  @@index([botInstanceId, placedAt(sort: Desc)])
  @@map("bot_trades")
}

// ---------------------------------------------------------------------------
// Feature flags — admin-managed, read by apps/api
// ---------------------------------------------------------------------------

// Read-only column-limited view of `users`, granted to derivdesk_admin
// instead of the raw table so apps/admin-api can never select
// password_hash even by accident. Defined by infra/db-init/001_roles.sql —
// this `view` block just gives admin-api a typed, read-only client for it.
// apps/admin-api code should only ever call findMany/findUnique on this.
view AdminVisibleUser {
  id          String    @id
  handle      String    // the user's Deriv account id (users have no email/password any more)
  status      UserStatus
  createdAt   DateTime  @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  @@map("admin_visible_users")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  updatedBy   String?  @map("updated_by") // admin_users.id, no FK (cross-deployment)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// Runner lease — at most ONE API process may run the bot runner at a time.
// Written only through the atomic statement in apps/api/src/lib/runnerLease.ts, which uses the
// DATABASE clock (never an application clock), so clock skew between instances can't cause two
// holders.
// ---------------------------------------------------------------------------

model RunnerLease {
  name       String   @id
  holderId   String   @map("holder_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  renewedAt  DateTime @default(now()) @map("renewed_at")
  expiresAt  DateTime @map("expires_at")

  @@map("runner_leases")
}
