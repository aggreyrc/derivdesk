# apps/admin-api production environment (compose `env_file`). chmod 600. Never commit the real file,
# and NEVER reuse a value from api.env: the two deployments must not share secrets.
# NODE_ENV, PORT and DATABASE_URL are set by the compose file.

# The admin web UI's own public (internal-network) URL — never the client app's origin.
CORS_ORIGIN=https://admin.internal.example.com

# Proxies in front of this API: the admin web container's nginx (1) + your VPN/internal LB (1) = 2.
TRUST_PROXY=2

SESSION_SECRET=                 # openssl rand -hex 32  (different from the client app's)
ADMIN_TOTP_ENCRYPTION_KEY=      # openssl rand -base64 32  (different from TOKEN_ENCRYPTION_KEY; BACK UP separately)
# During key rotation only (docs/operations.md):
# ADMIN_TOTP_ENCRYPTION_KEYS_EXTRA=

# Production refuses to start with this false.
ADMIN_REQUIRE_TOTP=true
