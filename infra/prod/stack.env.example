# Compose-level settings (read by `docker compose --env-file`). chmod 600. Never commit the real file.

# The public host name users type (no scheme). Used in the web container's CSP for the WebSocket.
PUBLIC_HOST=app.example.com

# Interface the two published ports bind to. Keep 127.0.0.1 and put a TLS terminator / VPN in front.
WEB_BIND=127.0.0.1
ADMIN_BIND=127.0.0.1

# Database credentials. Generate each with:  openssl rand -hex 24
POSTGRES_SUPERUSER_PASSWORD=
DERIVDESK_API_DB_PASSWORD=
DERIVDESK_ADMIN_DB_PASSWORD=
