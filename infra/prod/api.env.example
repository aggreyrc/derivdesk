# apps/api production environment (compose `env_file`). chmod 600. Never commit the real file, and never
# share it with admin-api. NODE_ENV, PORT, DATABASE_URL and METRICS_PORT are set by the compose file.
# The app REFUSES to boot in production if any of these look like placeholders or are not https.

# Same origin as the web app: the web container proxies /api and /ws, so this is its public URL.
CORS_ORIGIN=https://app.example.com
WEB_APP_URL=https://app.example.com

# Proxies between the internet and this API: TLS terminator (1) + the web container's nginx (1) = 2.
# Too LOW and every user shares one rate-limit bucket; too HIGH lets clients spoof their IP.
TRUST_PROXY=2

SESSION_SECRET=                 # openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=           # openssl rand -base64 32   (BACK THIS UP, separately from database backups)
# During key rotation only (docs/operations.md): comma-separated old/new keys accepted for decryption.
# TOKEN_ENCRYPTION_KEYS_EXTRA=

# Deriv — register an app at https://developers.deriv.com/ ; the redirect URI must match EXACTLY.
DERIV_CLIENT_ID=
DERIV_CLIENT_SECRET=
DERIV_OAUTH_REDIRECT_URI=https://app.example.com/api/deriv/callback
DERIV_OAUTH_SCOPES=trade
DERIV_API_BASE_URL=https://api.derivws.com
DERIV_PUBLIC_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_OAUTH_AUTHORIZE_URL=https://auth.deriv.com/oauth2/auth
DERIV_OAUTH_TOKEN_URL=https://auth.deriv.com/oauth2/token

# Safe on every replica: the database lease lets exactly one lead.
BOT_RUNNER_ENABLED=true
BOT_RUNNER_LEASE_TTL_MS=30000
