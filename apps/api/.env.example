# Client-facing backend (apps/api). Never share this deployment's env with apps/admin-api.

NODE_ENV=development
PORT=4000

# Connects as the least-privileged `derivdesk_api` role (see infra/db-init/001_roles.sql)
DATABASE_URL=postgresql://derivdesk_api:change_me_api@localhost:5432/derivdesk

# Origin allowed to call this API — the client web app only, never the admin app
CORS_ORIGIN=http://localhost:5173
# Where the Deriv OAuth callback redirects the browser back to (the client SPA)
WEB_APP_URL=http://localhost:5173

# Session cookie signing (32+ random bytes, e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace_with_a_long_random_value

# --- Deriv OAuth (Phase 3) ---
# Register an app at https://developers.deriv.com/ to get these. DERIV_CLIENT_ID is the
# same value Deriv calls the "App ID". DERIV_OAUTH_REDIRECT_URI must exactly match what's
# registered there, byte for byte. Leave these unset and /api/deriv/connect answers 503 —
# nothing else in the app requires them.
DERIV_CLIENT_ID=
DERIV_CLIENT_SECRET=
DERIV_OAUTH_REDIRECT_URI=http://localhost:4000/api/deriv/callback
DERIV_OAUTH_SCOPES=trade
DERIV_API_BASE_URL=https://api.derivws.com
# Public (no-auth) market-data gateway — Phase 4
# Whether THIS process may run bots. Safe on every instance: a database lease lets exactly one lead.
# Set to false on ALL instances to stop bots trading (running bots resume when re-enabled).
BOT_RUNNER_ENABLED=true
# Failover time if the leader dies without releasing (ms, renewed every third of this).
BOT_RUNNER_LEASE_TTL_MS=30000
DERIV_PUBLIC_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_OAUTH_AUTHORIZE_URL=https://auth.deriv.com/oauth2/auth
DERIV_OAUTH_TOKEN_URL=https://auth.deriv.com/oauth2/token

# --- Token/credential encryption at rest (Phase 3) ---
# 32 random bytes, base64: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
