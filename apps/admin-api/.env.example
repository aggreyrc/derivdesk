# Admin/ops backend (apps/admin-api). Fully separate deployment from apps/api:
# different host/port, different DB role, different session cookie, and it is
# never reachable from the public internet the same way apps/api is — put it
# behind a VPN, an allowlist, or an internal load balancer in production.

NODE_ENV=development
PORT=4100

# Connects as the restricted `derivdesk_admin` role (see infra/db-init/001_roles.sql).
# Note: no grant on deriv_oauth_tokens, users, sessions, local_trades,
# transactions_cache, watchlists, or notifications — see that file for the
# exact grant list. This is enforced by Postgres, not by this app's code.
DATABASE_URL=postgresql://derivdesk_admin:change_me_admin@localhost:5432/derivdesk

# Origin allowed to call this API — the admin app only, never the client web app
CORS_ORIGIN=http://localhost:5174

# Separate signing secret from apps/api — never reuse it across deployments
SESSION_SECRET=replace_with_a_different_long_random_value

# Reserved for step-up 2FA once TOTP verification is implemented (see
# README "Known limitations" — not yet wired in Phase 2)
TOTP_ENCRYPTION_KEY=replace_with_32_byte_key_base64

# --- Two-factor authentication (Phase 8) ---
# Key for the encrypted TOTP secrets: 32 random bytes, base64 (`openssl rand -base64 32`).
# Must NOT be the same value as apps/api's TOKEN_ENCRYPTION_KEY — this deployment never holds that key.
ADMIN_TOTP_ENCRYPTION_KEY=
# true (default): an admin without an enrolled authenticator cannot sign in. Refused as `false` in production.
# Enrol with: npm run enroll-totp --workspace apps/admin-api -- --email you@example.com
ADMIN_REQUIRE_TOTP=true

# Number of reverse-proxy hops in front of this API (0 = none). Never a blanket "true".
TRUST_PROXY=0
